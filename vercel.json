{
  "cleanUrls": true,
  "trailingSlash": false,
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/sync-mandi",
      "schedule": "0 1 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api|_expo|assets|static|favicon.ico|robots.txt|sitemap.xml|manifest.json).*)",
      "destination": "/index.html"
    }
  ]
}
